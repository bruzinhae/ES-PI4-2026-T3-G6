# .env.example — MODELO das variáveis de ambiente da API do AçaíStudy.
#
# Para que serve: o arquivo .env de verdade guarda segredos (como a senha do banco) e por isso
# NÃO vai para o GitHub (está no .gitignore). Este arquivo de exemplo vai, para que todo mundo
# do grupo saiba quais variáveis precisa configurar.
#
# Como usar: copie para backend/.env (`cp .env.example .env`) e preencha os valores.
# Quem lê estas variáveis é o src/config/env.js.

# Endereço de conexão do MongoDB. É a mesma URI do MongoDB Atlas usada no Compass
# (favorito AçaíStudy) — troque SUA_SENHA pela senha real do usuário do banco.
# O "/acaistudy" antes do "?" é o nome do banco. Se esta linha não existir, a API tenta o
# Mongo local: mongodb://localhost:27017/acaistudy (docker-compose do backend).
MONGODB_URI="mongodb+srv://henrique_db_user:SUA_SENHA@acaistudy.9drrdbe.mongodb.net/acaistudy?retryWrites=true&w=majority"

# Porta em que a API escuta. 3001 porque o frontend
# (JS/users/api.js) espera a API em http://localhost:3001/api.
PORT=3001

# Origens do frontend liberadas no CORS, separadas por vírgula ("*" libera todas).
# Em desenvolvimento "*" é o mais prático; em produção, coloque só o endereço do site.
CORS_ORIGIN="*"

# Endereço do frontend, usado para montar o link de recuperação de senha (por enquanto o link só
# aparece no console da API). Se esta linha não existir, usa http://localhost:5500.
FRONTEND_URL="http://localhost:5500"
